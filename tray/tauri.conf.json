{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deco.chat",
  "version": "0.1.11",
  "identifier": "com.decocms.chat.tray",
  "build": { "frontendDist": "static" },
  "app": { "windows": [], "security": { "csp": null } },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/vibebook", "binaries/hc"],
    "resources": { "binaries/herdr-core-licenses/": "licenses/herdr-core/" },
    "category": "Productivity",
    "shortDescription": "deco.chat in the menu bar",
    "license": "MIT",
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "11.0" },
    "linux": { "deb": { "depends": ["libayatana-appindicator3-1"] } }
  }
}
