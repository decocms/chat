{
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "<REPLACE_ME>"
      }
    ],
    "kv_namespaces": [
      {
        "binding": "OAUTH_KV",
        "id": "<REPLACE_ME>"
      }
    ],
    "r2_buckets": [
      {
        "binding": "FILES",
        "bucket_name": "<REPLACE_ME>"
      }
    ],
    "durable_objects": {
      "bindings": [
        {
          "name": "BOOK",
          "class_name": "Book"
        },
        {
          "name": "DOC_ROOMS",
          "class_name": "DocRoom"
        },
        {
          "name": "PEOPLE",
          "class_name": "Person"
        }
      ]
    },
    "ratelimits": [
      {
        "name": "AI_LIMIT",
        "namespace_id": "<REPLACE_ME>",
        "simple": {
          "limit": 10,
          "period": 60
        }
      },
      {
        "name": "LOGIN_LIMIT",
        "namespace_id": "<REPLACE_ME>",
        "simple": {
          "limit": 5,
          "period": 60
        }
      },
      {
        "name": "UPLOAD_LIMIT",
        "namespace_id": "<REPLACE_ME>",
        "simple": {
          "limit": 30,
          "period": 60
        }
      },
      {
        "name": "AGENT_LIMIT",
        "namespace_id": "<REPLACE_ME>",
        "simple": {
          "limit": 30,
          "period": 60
        }
      }
    ],
    "send_email": [
      {
        "name": "EMAIL",
        "destination_address": "<REPLACE_ME>"
      }
    ],
    "ai": {
      "binding": "AI"
    },
    "vars": {
      "MODEL_ROUTE": "deepseek/deepseek-v4.1-flash",
      "MODEL_CLASSIFY": "deepseek/deepseek-v4.1-flash",
      "MODEL_FAST": "anthropic/claude-haiku-5.5",
      "MODEL_JUDGE": "off",
      "METRICS_ROOMS": "",
      "ISSUES_ROOM": "",
      "AGENT_STREAK_OFF": ""
    }
  }
}
